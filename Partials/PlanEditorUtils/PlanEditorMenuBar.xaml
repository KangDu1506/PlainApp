<UserControl x:Class="PlainApp.Partials.PlanEditorUtils.PlanEditorMenuBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PlainApp.Partials.PlanEditorUtils"
             xmlns:services="clr-namespace:PlainApp.Services"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/Partials/PlanEditorStyles/PlanEditorMenuBarStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Style="{StaticResource MenuBarContainer}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    x:Name="UserContainer"/>

            <Button x:Name="PlanConfigButton"
                    Grid.Column="1"
                    Tag="⚙️"
                    Content="{Binding Source={x:Static services:LanguageManager.Instance}, Path=[Config]}"
                    Style="{StaticResource MenuButtonStyle}"/>

            <Button x:Name="AddTaskButton"
                    Grid.Column="2"
                    Tag="➕"
                    Content="{Binding Source={x:Static services:LanguageManager.Instance}, Path=[AddTask]}"
                    Style="{StaticResource MenuButtonStyle}"/>
            
            <Button x:Name="TabsButton"
                    Grid.Column="3"
                    Tag="📑"
                    Content="{Binding Source={x:Static services:LanguageManager.Instance}, Path=[Tabs]}"
                    Style="{StaticResource MenuButtonStyle}"/>

        </Grid>
    </Border>
</UserControl>
