<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="UpcomingTasksContainerStyle" TargetType="Border">
        <Setter Property="Margin" Value="10"/>
        <Setter Property="Background" Value="{DynamicResource 70%TransparentBlackBrush}"/>
        <Setter Property="CornerRadius" Value="5"/>
    </Style>

    <Style x:Key="UpcomingTasksHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource LightBlueBrush}"/>
        <Setter Property="Margin" Value="10"/>
        <Setter Property="FontFamily" Value="{DynamicResource AppCurrentFont}"/>
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SperatorStyle" TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource LightBlueBrush}"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="10,0"/>
    </Style>

    <Style x:Key="CalendarContainerStyle" TargetType="Border">
        <Setter Property="Margin" Value="10"/>
        <Setter Property="Background" Value="{DynamicResource 70%TransparentBlackBrush}"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="MinHeight" Value="800"/>
    </Style>

    <Style x:Key="CalendarMonthYearNavigationButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource BareGrayBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource AppCurrentFont}"/>
        <Setter Property="FontSize" Value="16"/>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource DeepDarkBlueBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="MonthYearTextBlockStyle" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontFamily" Value="{DynamicResource AppCurrentFont}"/>
        <Setter Property="Foreground" Value="{DynamicResource LightBlueBrush}"/>
    </Style>

    <Style x:Key="DayOfWeekStyle" TargetType="Label">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontFamily" Value="{DynamicResource AppCurrentFont}"/>
        <Setter Property="Foreground" Value="{DynamicResource DeepDarkBlueBrush}"/>

        <Setter Property="Background" Value="{DynamicResource ExtremeLightBlueBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Label">
                    <Border BorderBrush="Transparent"
                            Background="{TemplateBinding Background}"
                            Padding="10, 2.5"
                            CornerRadius="15"
                            ClipToBounds="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>