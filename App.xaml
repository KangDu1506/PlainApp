<Application x:Class="PlainApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PlainApp"
             xmlns:lang="clr-namespace:PlainApp.Languages"
             xmlns:services="clr-namespace:PlainApp.Services"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Assets/ColorPalettes/DarkBluePalette.xaml"/>                
                <ResourceDictionary Source="/Assets/Brushes.xaml"/>
                <ResourceDictionary Source="/Styles/CoreWindowStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="AppCurrentFont">/Assets/Fonts/#Rounded Mplus 1c</FontFamily>
            
        </ResourceDictionary>
    </Application.Resources>
</Application>
