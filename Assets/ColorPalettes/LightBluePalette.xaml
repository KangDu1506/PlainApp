<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="DeepDarkBlue">#121966</Color>
    <Color x:Key="DarkBlue">#1D289B</Color>
    <Color x:Key="PrimaryBlue">#2A4DFF</Color>
    <Color x:Key="MediumBlue">#52C4C4</Color>
    <Color x:Key="OutlineHightLighterBlue">#83ECE5</Color>
    <Color x:Key="LightBlue">#AEFFC5</Color>
    <Color x:Key="ExtremeLightBlue">#FAFAFA</Color>
    <Color x:Key="PrimaryHighlighter">#FF477E</Color>
    <Color x:Key="DimmerPrimaryHighlighter">#E0366B</Color>

    <!-- Default brushes -->
    <!--#region Default brushes -->
    <SolidColorBrush x:Key="DeepDarkBlueBrush" Color="{DynamicResource DeepDarkBlue}" />
    <SolidColorBrush x:Key="DarkBlueBrush" Color="{DynamicResource DarkBlue}" />
    <SolidColorBrush x:Key="PrimaryBlueBrush" Color="{DynamicResource PrimaryBlue}" />
    <SolidColorBrush x:Key="MediumBlueBrush" Color="{DynamicResource MediumBlue}" />
    <SolidColorBrush x:Key="OutlineHightLighterBlueBrush" Color="{DynamicResource OutlineHightLighterBlue}" />
    <SolidColorBrush x:Key="LightBlueBrush" Color="{DynamicResource LightBlue}" />
    <SolidColorBrush x:Key="ExtremeLightBlueBrush" Color="{DynamicResource ExtremeLightBlue}" />
    <SolidColorBrush x:Key="PrimaryHighlighterBrush" Color="{DynamicResource PrimaryHighlighter}" />
    <SolidColorBrush x:Key="DimmerPrimaryHighlighterBrush" Color="{DynamicResource DimmerPrimaryHighlighter}" />
    <!--#endregion-->
    
    <!-- Extra brushes -->
    <!-- #region SideMenu Extra brushes -->
    <SolidColorBrush x:Key="SideMenuOpaqueOverlayBrush" Color="{DynamicResource DeepDarkBlue}" Opacity="0.3"/>
    <SolidColorBrush x:Key="SideMenuTransparentOverlayBrush" Opacity="0"/>
    <SolidColorBrush x:Key="SideMenuBackgroundOpacityBrush" Color="{DynamicResource MediumBlue}" Opacity="0.3"/>
    <!-- endregion -->

</ResourceDictionary>